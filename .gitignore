# Entorno y secretos
.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Datos: los avisos recolectados NO se suben al repositorio (ver README, "Datos y privacidad")
datos/*
!datos/barrios_localidad.csv
!datos/.gitkeep
carga_manual/*
!carga_manual/plantilla_captura.csv

# Configuración local: cada equipo tiene la suya (autorización de términos, correo de contacto).
# El zip y el repositorio traen config/portales.ejemplo.yaml; la aplicación la copia la primera vez.
# Así descomprimir una versión nueva nunca borra la autorización ni el correo.
config/portales.yaml

# Productos que se regeneran
artefactos/*
!artefactos/.gitkeep
mlruns/
*.db

.DS_Store
.vscode/
.idea/
.ruff_cache/
node_modules/
