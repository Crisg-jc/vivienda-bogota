# Copiar como .env (que NO se sube al repositorio)

# Base de datos de la recolección. Con Docker: docker compose --profile recoleccion up -d db
POSTGRES_DB=vivienda
POSTGRES_USER=vivienda
POSTGRES_PASSWORD=cambiar_esta_clave
DATABASE_URL=postgresql+psycopg2://vivienda:cambiar_esta_clave@localhost:5432/vivienda
# Para probar sin Docker:
# DATABASE_URL=sqlite:///datos/vivienda.db

# Dataset que usa la aplicación (opcional). Si no se define, usa el corte más reciente datos/dataset_vN.csv.
# VIVIENDA_DATASET=datos/dataset_v3.csv
